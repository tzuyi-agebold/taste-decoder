// Copy this file to Config/Secrets.xcconfig (it is gitignored) and fill in your values.
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig

// Your Apple Developer Team ID (10 characters), e.g. AB12CD34EF.
TD_DEVELOPMENT_TEAM =

// Something unique to you. Bundle ids become <prefix>.TasteDecoder and <prefix>.TasteDecoder.Share.
TD_BUNDLE_ID_PREFIX = com.yourname

// Your Claude API key from https://platform.claude.com (starts with sk-ant-).
// Note: xcconfig treats a double slash as a comment, so paste the key as-is on one line.
CLAUDE_API_KEY =

// Optional: claude-opus-5-5 (default, best), claude-sonnet-5-5 (faster), claude-haiku-4-5 (fastest).
// CLAUDE_MODEL = claude-opus-5-5

// Free Apple ID (personal team)? App Groups aren't available, so uncomment these two lines.
// Everything works except handing saves from the Share Extension to the app.
// TD_APP_ENTITLEMENTS =
// TD_SHARE_ENTITLEMENTS =
